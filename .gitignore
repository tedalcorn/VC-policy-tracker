# Regenerable data — recreate with `python update.py`
data/raw/
data/processed/

# Bundled processed text for the dashboard's full-text search is 8.9MB and
# also regenerable; gitignore it to keep the repo lean. Anyone cloning who
# wants the dashboard locally runs `python update.py --no-fetch` after
# providing a Ghost API key or copy of the raw dump.
docs/data/articles_text.json

